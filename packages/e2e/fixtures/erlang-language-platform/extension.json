{
  "id": "test.erlang-language-platform",
  "name": "Erlang Language Platform",
  "browser": "main.js",
  "isolated": true,
  "activation": ["onFormatting:erlang-language-platform-diagnostic-driver"],
  "formattingProviders": [
    {
      "id": "erlang-language-platform-diagnostic-driver",
